{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "black", "color": "#000000", "name": "Black" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" },
				{ "slug": "gray-950", "color": "#0A0A0A", "name": "Gray 950" },
				{ "slug": "gray-900", "color": "#111111", "name": "Gray 900" },
				{ "slug": "gray-800", "color": "#1A1A1A", "name": "Gray 800" },
				{ "slug": "gray-700", "color": "#2A2A2A", "name": "Gray 700" },
				{ "slug": "gray-400", "color": "#A3A3A3", "name": "Gray 400" },
				{ "slug": "primary", "color": "#00F0FF", "name": "Primary (Cyan)" },
				{ "slug": "primary-dim", "color": "#00B8C4", "name": "Primary Dim" },
				{ "slug": "secondary", "color": "#7B61FF", "name": "Secondary (Purple)" },
				{ "slug": "accent", "color": "#00FF9D", "name": "Accent (Neon)" }
			]
		},
		"typography": {
			"fontFamilies": [
				{ "fontFamily": "\"Space Grotesk\", \"Orbitron\", system-ui, sans-serif", "slug": "display", "name": "Display" },
				{ "fontFamily": "Inter, system-ui, -apple-system, sans-serif", "slug": "body", "name": "Body" },
				{ "fontFamily": "\"JetBrains Mono\", \"Fira Code\", ui-monospace, monospace", "slug": "mono", "name": "Mono" }
			],
			"fontSizes": [
				{ "slug": "xs", "size": "0.75rem", "name": "XS" },
				{ "slug": "sm", "size": "0.875rem", "name": "SM" },
				{ "slug": "base", "size": "1rem", "name": "Base" },
				{ "slug": "lg", "size": "1.125rem", "name": "LG" },
				{ "slug": "xl", "size": "1.25rem", "name": "XL" },
				{ "slug": "2xl", "size": "1.5rem", "name": "2XL" },
				{ "slug": "3xl", "size": "1.875rem", "name": "3XL" },
				{ "slug": "4xl", "size": "2.25rem", "name": "4XL" },
				{ "slug": "5xl", "size": "3rem", "name": "5XL" },
				{ "slug": "6xl", "size": "3.75rem", "name": "6XL" }
			]
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "1", "size": "0.25rem", "name": "1" },
				{ "slug": "2", "size": "0.5rem", "name": "2" },
				{ "slug": "3", "size": "0.75rem", "name": "3" },
				{ "slug": "4", "size": "1rem", "name": "4" },
				{ "slug": "5", "size": "1.5rem", "name": "5" },
				{ "slug": "6", "size": "2rem", "name": "6" },
				{ "slug": "8", "size": "3rem", "name": "8" },
				{ "slug": "10", "size": "4rem", "name": "10" },
				{ "slug": "12", "size": "6rem", "name": "12" }
			]
		},
		"border": { "radius": true },
		"custom": { "radius": { "sm": "4px", "md": "8px", "lg": "12px", "xl": "16px" } }
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--gray-950)",
			"text": "var(--wp--preset--color--white)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": { "color": { "text": "var(--wp--preset--color--primary-dim)" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.15"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--black)"
				},
				"border": { "radius": "8px" },
				":hover": {
					"color": { "background": "var(--wp--preset--color--primary-dim)" }
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "single-termimal_product", "title": "Single Product", "postTypes": ["termimal_product"] }
	]
}
