{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"title": "Minimal",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "black", "color": "#050505", "name": "Black" },
				{ "slug": "white", "color": "#F5F5F5", "name": "White" },
				{ "slug": "primary", "color": "#00D4E0", "name": "Primary" },
				{ "slug": "secondary", "color": "#6B5CE7", "name": "Secondary" },
				{ "slug": "accent", "color": "#00E89A", "name": "Accent" },
				{ "slug": "gray-950", "color": "#080808", "name": "Gray 950" },
				{ "slug": "gray-900", "color": "#0F0F0F", "name": "Gray 900" },
				{ "slug": "gray-800", "color": "#161616", "name": "Gray 800" },
				{ "slug": "gray-700", "color": "#222222", "name": "Gray 700" },
				{ "slug": "gray-400", "color": "#9A9A9A", "name": "Gray 400" },
				{ "slug": "gray-200", "color": "#E5E5E5", "name": "Gray 200" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--gray-950)",
			"text": "var(--wp--preset--color--gray-200)"
		},
		"elements": {
			"heading": { "typography": { "fontWeight": "500", "letterSpacing": "-0.02em" } },
			"link": { "color": { "text": "var(--wp--preset--color--primary)" } },
			"button": {
				"border": { "radius": "6px" },
				"color": { "background": "var(--wp--preset--color--primary)", "text": "#000000" }
			}
		}
	}
}
